#include <stdio.h>
int main(void) {
float celsiusParaFahrenheit(float celsius);
float tempcelsius = 25.0;
float tempfahrenheit =
celsiusParaFahrenheit(tempcelsius);
printf("%.1f c equivale a %.1f f\n", tempcelsius,
tempfahrenheit);
return 0;
}
float celsiusParaFahrenheit(float celsius) {
return (celsius * 9.0/5.0) + 32.0;
}
